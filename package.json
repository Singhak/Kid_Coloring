    "generate:long": "tsx scripts/publish_video.ts --generate-only --aspect=16:9 --duration=60",
    "social:publish": "tsx scripts/publish_video.ts",
    "youtube:publish": "tsx scripts/publish_video.ts --target=youtube",
    "youtube:publish:long": "tsx scripts/publish_video.ts --target=youtube --aspect=16:9 --duration=60",
    "instagram:publish": "tsx scripts/publish_video.ts --target=instagram",
    "deploy": "deploy.bat"
  },
  "dependencies": {
