rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    // User profile rules
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        request.resource.data.uid == uid;
      allow update: if isOwner(uid);
    }

    // Orders collection: strictly keyed on orderId to prevent duplicate entries & handle idempotency
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid && 
        request.resource.data.orderId == orderId;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
